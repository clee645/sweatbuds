EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# RevenueCat public SDK keys (per platform).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-revenuecat-ios-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your-revenuecat-android-key

# PostHog product analytics. Optional locally — when either is unset the client
# degrades to a no-op and logs a warning in dev.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your-project-token
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: App Review demo bypass. When set, entering this code on the paywall
# unlocks the app locally (no purchase / entitlement). Leave unset to disable
# the bypass entirely. Document the active value in the App Review notes.
EXPO_PUBLIC_DEMO_ACCESS_CODE=
